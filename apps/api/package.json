{
  "name": "@svdt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "build": "node scripts/build-vercel.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/cli.ts migrate",
    "create-key": "tsx src/cli.ts create-key",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@hono/zod-openapi": "1.6.3",
    "@svdt/db": "workspace:*",
    "@svdt/domain": "workspace:*",
    "@svdt/importers": "workspace:*",
    "@svdt/rule-packs": "workspace:*",
    "@svdt/tax-engine": "workspace:*",
    "hono": "4.13.13",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@svdt/config": "workspace:*",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
